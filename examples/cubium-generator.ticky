# Copper + iron generator for Cubium: four rows of crafters, each set to one recipe at a time
# ("Set recipe" from its own output), choosing between
#
#   cube-jelly-ore-advanced-copper   1 e-cube + 50 jelly -> 41 copper ore + 1 d-cube
#   cube-jelly-ore-advanced-iron     1 e-cube + 50 jelly -> 41 iron ore + 1 d-cube
#   matter-amplification             1 e-cube + 10 jelly -> 17 jelly + 1 d-cube
#   cube-jelly                       1 e-cube            -> 2 jelly + 1 d-cube (only to start
#                                                           from no jelly: amplification needs 10)
#   metallic-aggravation             1 d-cube + 2 copper -> 1 e-cube
#
# The controller looks at one row at a time, taking turns (each row every 2.7 seconds). It scores
# each recipe by how much it is needed and whether its inputs are in the warehouse, and gives
# the row the best one if the row is free, counting the other rows already on a recipe
# against it so the four rows spread out. A row is free when none of
# its crafters is working (signal-A..D = 0) and it has had HOLD ticks to get its ingredients
# since its last change.
#
# Copper is what turns dormant cubes back into energized ones, so it comes first: the copper
# score counts the plates every dormant cube will need (2 each), and iron ore only runs while
# there's a row's worth of recharging copper. Jelly is only made while the ore rows can use it,
# without eating the cubes they need. Busy rows are interrupted only for that: jelly rows
# (short recipes, cheap to stop) once there's enough jelly or the cubes run low, plain
# cube-jelly once there's enough to amplify, and iron rows if copper runs out.
#
# No productivity needed: 41 ore takes 50 jelly (~7.1 amplifications) + 1 charge for the ore
# itself, ~8.1 charges = ~16 copper plates, so each copper ore craft nets ~25 copper. (Rows
# switch recipes, and metallic-aggravation takes no productivity modules, so a row would
# eject its modules when it switched to it.)

input  warehouse: Bundle = port("Warehouse contents")
input  crafter_status: Bundle = port("Crafters working: signal-A..D for rows 1-4")

output craft_target_1: Signal = port("Row 1 recipe")
output craft_target_2: Signal = port("Row 2 recipe")
output craft_target_3: Signal = port("Row 3 recipe")
output craft_target_4: Signal = port("Row 4 recipe")

COPPER_ORE = S("cube-jelly-ore-advanced-copper", type="recipe")
IRON_ORE   = S("cube-jelly-ore-advanced-iron", type="recipe")
JELLY      = S("cube-jelly", type="recipe")
AMPLIFY    = S("matter-amplification", type="recipe")
RECHARGE   = S("metallic-aggravation", type="recipe")

# Inside, a row's recipe is a number (cheaper to compare and count than signals).
IDLE = 0
COPPER = 1
IRON = 2
JELLY_ROW = 3
CHARGE = 4
AMP = 5

ROW_SIZE     = 20      # crafters per row; the stocks below are sized from it
PLATE_GOAL   = 10000   # ore scores fall towards 1 as plates near this, but never reach 0
JELLY_GOAL   = 50 * ROW_SIZE   # make jelly up to one row of ore crafts' worth
AMP_MIN      = 30      # amplify from here up (each needs 10); plain cube-jelly below
CUBE_RESERVE = ROW_SIZE        # energized cubes jelly rows leave for one row of ore crafts
COPPER_FLOOR = 16 * ROW_SIZE   # iron ore waits for this much copper (a row of ore crafts
                               # uses ~8 cube charges each, 2 copper per charge)
SHARE        = 300     # a recipe's score drops by this for each other row already on it
HOLD         = 600     # ticks a row keeps a new recipe before it may change again
PERIOD       = 40      # ticks per turn; a row's turn comes every 4 * PERIOD

rows = [IDLE] * 4
since = [HOLD] * 4     # ticks since each row's recipe last changed
turn = 0

def ore_score(plates):
    # 1000 with no plates, 1 at PLATE_GOAL, up to 2000 when plates are owed (negative).
    return max(1, (PLATE_GOAL - min(max(plates, -PLATE_GOAL), PLATE_GOAL)) * 1000 // PLATE_GOAL)

def score(want, r, cur):
    # `want`, less SHARE for each other row on recipe r; 0 if r isn't wanted at all.
    others = (1 if rows[0] == r else 0) + (1 if rows[1] == r else 0) + (1 if rows[2] == r else 0) \
        + (1 if rows[3] == r else 0) - (1 if cur == r else 0)
    return want - SHARE * others if want > 0 else 0

def recipe(r):
    return (COPPER_ORE if r == COPPER else IRON_ORE if r == IRON else JELLY if r == JELLY_ROW
            else RECHARGE if r == CHARGE else AMPLIFY if r == AMP else Bundle().argmax())

every 40 ticks:
    copper = warehouse["copper-plate"]
    iron = warehouse["iron-plate"]
    jelly = warehouse["cube-jelly"]
    charged = warehouse["energized-microcube"]
    dormant = warehouse["dormant-microcube"]

    # How much each recipe is wanted right now (0: not at all, or its inputs aren't there).
    ore_ok = charged > 0 and jelly >= 50
    want_copper = ore_score(copper - 2 * dormant) if ore_ok else 0
    want_iron = ore_score(iron) if ore_ok and copper >= COPPER_FLOOR else 0
    # Jelly may use the reserve cubes only while there's too little jelly for any ore.
    can_jelly = charged > CUBE_RESERVE or (jelly < 50 and charged > 0)
    jelly_need = (JELLY_GOAL - jelly) * 1000 // JELLY_GOAL if jelly < JELLY_GOAL and can_jelly else 0
    want_jelly = jelly_need if jelly < AMP_MIN else 0
    want_amp = jelly_need if jelly >= AMP_MIN else 0
    want_charge = dormant * 1000 // (dormant + charged) if dormant > 0 and copper >= 2 else 0
    stop_jelly = jelly >= JELLY_GOAL or not can_jelly

    # This turn's row. It keeps its recipe while busy (unless that wastes jelly) and for HOLD
    # ticks after a change, so its ingredients have time to arrive.
    cur = rows[turn]
    working = [crafter_status["signal-A"], crafter_status["signal-B"],
               crafter_status["signal-C"], crafter_status["signal-D"]][turn]
    busy = working > 0 or since[turn] < HOLD
    stop = (cur == AMP and stop_jelly) or (cur == JELLY_ROW and (stop_jelly or jelly >= AMP_MIN)) \
        or (cur == IRON and copper < COPPER_FLOOR // 2)
    if cur == IDLE or not busy or stop:
        best = IDLE
        top = 0
        s = score(want_copper, COPPER, cur)
        if s > top:
            best, top = COPPER, s
        s = score(want_iron, IRON, cur)
        if s > top:
            best, top = IRON, s
        s = score(want_jelly, JELLY_ROW, cur)
        if s > top:
            best, top = JELLY_ROW, s
        s = score(want_amp, AMP, cur)
        if s > top:
            best, top = AMP, s
        s = score(want_charge, CHARGE, cur)
        if s > top:
            best, top = CHARGE, s
        if best != cur:
            rows[turn] = best
            since[turn] = 0
    since = [min(t + PERIOD, HOLD) for t in since]
    turn = (turn + 1) % 4

    craft_target_1 = recipe(rows[0])
    craft_target_2 = recipe(rows[1])
    craft_target_3 = recipe(rows[2])
    craft_target_4 = recipe(rows[3])

test "cold start: no jelly, so rows make jelly and recharge cubes":
    # jelly 1000, recharge 500 (half the cubes are dormant): jelly, jelly (700), recharge
    # (jelly is down to 400), jelly (recharge is down to 200).
    set warehouse = {"energized-microcube": 10, "dormant-microcube": 10, "copper-plate": 100}
    run 300 ticks
    assert craft_target_1 == JELLY and craft_target_2 == JELLY
    assert craft_target_3 == RECHARGE and craft_target_4 == JELLY

test "low copper: every row on copper ore, none on iron":
    # copper 990; iron waits for COPPER_FLOOR; jelly can't take the cubes the ore rows need.
    set warehouse = {"energized-microcube": 20, "cube-jelly": 300, "copper-plate": 100, "iron-plate": 100}
    run 300 ticks
    assert craft_target_1 == COPPER_ORE and craft_target_2 == COPPER_ORE
    assert craft_target_3 == COPPER_ORE and craft_target_4 == COPPER_ORE

test "plenty of copper: iron ore too":
    # copper 500, iron 990: iron, iron (690), copper (500 vs iron 390), iron (390 vs copper 200).
    set warehouse = {"energized-microcube": 20, "cube-jelly": 300, "copper-plate": 5000, "iron-plate": 100}
    run 300 ticks
    assert craft_target_1 == IRON_ORE and craft_target_2 == IRON_ORE
    assert craft_target_3 == COPPER_ORE and craft_target_4 == IRON_ORE

test "dormant cubes count against copper (the stall seen in game)":
    # 1499 dormant cubes owe ~3000 copper and there's none: all rows to copper ore, none to
    # iron (they'd fight over the last cube), no jelly (there's plenty).
    set warehouse = {"energized-microcube": 1, "dormant-microcube": 1499, "cube-jelly": 1498}
    run 300 ticks
    assert craft_target_1 == COPPER_ORE and craft_target_2 == COPPER_ORE
    assert craft_target_3 == COPPER_ORE and craft_target_4 == COPPER_ORE

test "with some jelly but not enough for ore, rows amplify it":
    set warehouse = {"energized-microcube": 10, "cube-jelly": 40, "copper-plate": 100}
    run 300 ticks
    assert craft_target_1 == AMPLIFY and craft_target_2 == AMPLIFY
    assert craft_target_3 == AMPLIFY and craft_target_4 == AMPLIFY

test "plain cube-jelly rows switch once there's jelly to amplify":
    set warehouse = {"energized-microcube": 10}
    run 300 ticks
    assert craft_target_1 == JELLY
    set crafter_status = {"signal-A": 4, "signal-B": 4, "signal-C": 4, "signal-D": 4}
    set warehouse = {"energized-microcube": 10, "cube-jelly": 35}
    run 300 ticks
    assert craft_target_1 == AMPLIFY

test "busy rows keep their recipe":
    set warehouse = {"energized-microcube": 20, "cube-jelly": 300, "copper-plate": 100, "iron-plate": 5000}
    run 300 ticks
    assert craft_target_1 == COPPER_ORE
    set crafter_status = {"signal-A": 4}
    set warehouse = {"energized-microcube": 50, "cube-jelly": 300, "copper-plate": 9000, "iron-plate": 100}
    run 1200 ticks
    # Row 1 is still on copper; the idle rows moved to iron (990), amplifying (jelly 700 vs
    # iron 690) and iron (690 vs 400).
    assert craft_target_1 == COPPER_ORE
    assert craft_target_2 == IRON_ORE and craft_target_3 == AMPLIFY and craft_target_4 == IRON_ORE
    set crafter_status = {}
    run 300 ticks
    # Free again: amplifying 400 (one other row on it), iron 390 (two), copper 100.
    assert craft_target_1 == AMPLIFY

test "jelly rows stop once there's enough jelly":
    set warehouse = {"energized-microcube": 100, "copper-plate": 100}
    run 300 ticks
    assert craft_target_1 == JELLY
    set crafter_status = {"signal-A": 4, "signal-B": 4, "signal-C": 4, "signal-D": 4}
    set warehouse = {"energized-microcube": 100, "cube-jelly": 1200, "copper-plate": 100, "iron-plate": 100}
    run 300 ticks
    assert craft_target_1 != JELLY and craft_target_2 != JELLY
    assert craft_target_3 != JELLY and craft_target_4 != JELLY
    assert craft_target_1 != AMPLIFY and craft_target_2 != AMPLIFY
    assert craft_target_3 != AMPLIFY and craft_target_4 != AMPLIFY

test "iron rows stop if copper runs out":
    set warehouse = {"energized-microcube": 50, "cube-jelly": 300, "copper-plate": 5000, "iron-plate": 100}
    run 300 ticks
    assert craft_target_1 == IRON_ORE
    set crafter_status = {"signal-A": 4, "signal-B": 4, "signal-C": 4, "signal-D": 4}
    set warehouse = {"energized-microcube": 50, "cube-jelly": 300, "copper-plate": 100, "iron-plate": 100}
    run 300 ticks
    assert craft_target_1 != IRON_ORE and craft_target_3 != IRON_ORE

test "nothing to do: rows idle":
    run 300 ticks
    assert not craft_target_1 and not craft_target_4
