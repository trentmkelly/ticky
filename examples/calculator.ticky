# Ticky level-1 demo: a little calculator. Set N, then turn S on.
input  n: int @ N = port("The number to crunch (0 to 46)")
input  start: bool @ S = port("Turn on to calculate")

output fib: int @ F         # Fibonacci(n)
output primes: int @ P      # how many primes are <= n
output collatz: int @ C     # Collatz steps from n down to 1
output busy: bool @ B       # on while calculating
output took: int @ T        # ticks the last calculation took
output runs: int @ R        # calculations so far
output heartbeat: bool @ H  # blinks once a second, to show it's alive

every 30 ticks:
    heartbeat = not heartbeat

runs = 0
while True:
    wait until start
    busy = True
    began = ticks()

    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    fib = a

    count = 0
    for k in range(2, n + 1):
        d = 2
        prime = True
        while d * d <= k:
            if k % d == 0:
                prime = False
                break
            d += 1
        if prime:
            count += 1
    primes = count

    steps = 0
    x = n
    while x > 1:
        x = x // 2 if x % 2 == 0 else 3 * x + 1
        steps += 1
    collatz = steps

    took = ticks() - began
    runs += 1
    busy = False
    wait until not start

test "n = 10":
    set n = 10
    set start = True
    run until runs == 1, max 2000 ticks
    assert fib == 55 and primes == 4 and collatz == 6 and not busy and took > 0

test "n = 27, twice":
    set n = 27
    set start = True
    run until runs == 1, max 3000 ticks
    assert fib == 196418 and primes == 9 and collatz == 111
    set start = False
    run 10 ticks
    set n = 46
    set start = True
    run until runs == 2, max 6000 ticks
    assert fib == 1836311903 and primes == 14 and collatz == 16
